# systemd template: systemctl enable --now puck@$(whoami)
# $HOME resolves from the passwd db for User=, so this works whatever the
# guest home is (Lima 2.x on Windows: /home/<user>.guest).
[Unit]
Description=Puck dedicated server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
# Profiler steady state: Harmony instruments the proven-safe set; the 3
# Harmony-breaking types (Snapshot/Data/TickHeader) use in-method SyncPerf
# timing to its own file instead. See AGENTS.md.
Environment=PUCK_PROFILE=1
Environment=PUCK_SYNC_PROFILE=1
Environment="PUCK_PROFILE_SKIP=SynchronizedObjectClientDiagnostics;SynchronizedObjectClientReceiver;SynchronizedObjectController;SynchronizedObjectData;SynchronizedObjectDriveCadence;SynchronizedObjectInterpolator;SynchronizedObjectLodCounts;SynchronizedObjectLodSelection;SynchronizedObjectLodSource;SynchronizedObjectManagerController;SynchronizedObjectNetworkSmoothingSettings;SynchronizedObjectPlayback;SynchronizedObjectPlayerDiagnosticsData;SynchronizedObjectPose;SynchronizedObjectSample;SynchronizedObjectSendState;SynchronizedObjectServerDiagnostics;SynchronizedObjectSnapshot;SynchronizedObjectSmoothing;SynchronizedObjectTickHeader;SynchronizedObjectTimeline;SynchronizedObjectReceivedState;SynchronizedObjectBandSettings"
ExecStart=/bin/bash -c 'cd "$HOME/puck-server/server" && export LD_LIBRARY_PATH="$PWD:$LD_LIBRARY_PATH" && exec ./Puck -batchmode -nographics'
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillSignal=SIGKILL

[Install]
WantedBy=multi-user.target
