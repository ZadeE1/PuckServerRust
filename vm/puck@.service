# systemd template: systemctl enable --now puck@$(whoami)
# $HOME resolves from the passwd db for User=, so this works whatever the
# guest home is (Lima 2.x on Windows: /home/<user>.guest).
[Unit]
Description=Puck dedicated server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
# Profiler is opt-in; SKIP keeps the known-freezing sync pipeline out (see AGENTS.md).
Environment=PUCK_PROFILE=1
Environment=PUCK_PROFILE_SKIP=SynchronizedObject
ExecStart=/bin/bash -c 'cd "$HOME/puck-server/server" && export LD_LIBRARY_PATH="$PWD:$LD_LIBRARY_PATH" && exec ./Puck -batchmode -nographics'
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillSignal=SIGKILL

[Install]
WantedBy=multi-user.target
