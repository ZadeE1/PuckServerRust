# .NET build artifacts — regenerated by `dotnet build` on every change,
# and bin/ also contains copies of the game's dependency DLLs.
decompiled/Puck/bin/
decompiled/Puck/obj/

# IDE state
.vs/
.idea/
*.user

# Runtime output — machine- and session-specific, rewritten on every run
/Logs/
/performance_log/

# Local runtime toggle for the performance monitor; committing it would
# force monitoring OFF for every fresh clone.
performance_monitor_disabled.txt

# Puck game build (from the Steam install): large copyrighted binaries and
# asset payload that would bloat the repo permanently. Puck_Data/Managed/
# Puck.dll is itself a build product of decompiled/Puck — rebuilt and
# redeployed on every change — so the tree must never track it.
/Puck.exe
/UnityCrashHandler64.exe
/UnityPlayer.dll
/steamclient.dll
/*_Data/
/D3D12/
/MonoBleedingEdge/
